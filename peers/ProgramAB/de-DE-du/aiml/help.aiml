<?xml version="1.0" encoding="UTF-8"?>
<aiml>
  <!-- File: help.aiml -->
  <!--  -->
<category><pattern>* HILFE *</pattern>
<template><srai>HILFE</srai></template>
</category>
<category><pattern>* HILFE</pattern>
<template><srai>HILFE</srai></template>
</category>
<category><pattern>HILFE *</pattern>
<template><srai>HILFE</srai></template>
</category>
<category><pattern>HILFEN</pattern>
<template><srai>HILFE</srai></template>
</category>
<category><pattern>HILFE</pattern>
<template>Sie können jetzt die Hilfeliste in der Chatbot-GUI überprüfen. Sie können jede Zeile per Sprachbefehl steuern, um weitere Hilfe zu erhalten, oder sie in das Textfeld eingeben: HILFE GESTEN , HILFE GUI, HILFESERVICE.
        </template>
</category>
<category><pattern>HILFE GESTEN</pattern>
<template>Hier ist eine kurze Liste der Sprachbefehle:<br/>
          SCHLIESSE DEINEN FINGER.<br/>
          ÖFFNEN DEINEN FINGER.<br/>
          FINGER IN DIE MITTE.<br/>
          BEWEGE DEINEN FINGER.<br/>
          ÖFFNE DEINE HAND.<br/>
          SCHLIESSE DEINE HAND.<br/>
          HÄNDE ÖFFNEN.<br/>
          HÄNDE SCHLIESSEN.<br/>
          ÖFFNE DEINE RECHTE HAND.<br/>
          ÖFFNE DEINE LINKE HAND.<br/>
          SCHLIESSEN DEINE RECHTE HAND.<br/>
          SCHLIESSEN DEINE LINKE HAND.<br/>
          SCHLIESSEN LANGSAM DEINE RECHTE HAND.<br/> Sie können eine längere Liste auf der Registerkarte „Python“ anzeigen, aber Sie können noch VIEL mehr Sprachbefehle in den Ordnern „resource“, „programAB“ und „aiml files“ finden.          <oob>
        <mrl>
          <service>python</service><method>exec</method><param>printList_DE()</param>
        </mrl>
      </oob>
      </template>
</category>
<category><pattern>HILFE GUI</pattern>
<template><oob>
          <mrl>
            <service>webgui</service>
            <method>startBrowser</method>
            <param>https://inmoov.fr/inmoov2-in-nixie/</param>
          </mrl>
        </oob></template>
</category>

<category><pattern>HILFESERVICE</pattern>
<template>Sie können einen Dienst lautstark starten oder freigeben. Als Beispiel kann man sagen: STARTE DEN SERVICE LINKE HAND or SERVICE KOPF BEENDEN</template>
</category>

<category><pattern>STARTE DEN SERVICE *</pattern>
    <template>
        <oob>
            <mrl>
                <service>i01</service>
                <method>startPeer</method>
                <param><star/></param>
            </mrl>
        </oob>
    </template>
</category>
<category><pattern>SERVICE * BEENDEN</pattern>
    <template>
        <oob>
            <mrl>
                <service>i01</service>
                <method>releasePeer</method>
                <param><star/></param>
            </mrl>
        </oob>
    </template>
</category>

<category><pattern>STARTE DEN SERVICE RECHTE HAND</pattern>
    <template>
        <oob>
            <mrl>
                <service>i01</service>
                <method>startPeer</method>
                <param>rightHand</param>
            </mrl>
        </oob>
    </template>
</category>

<category><pattern>SERVICE RECHTE HAND BEENDEN</pattern>
    <template>
        <oob>
            <mrl>
                <service>i01</service>
                <method>releasePeer</method>
                <param>rightHand</param>
            </mrl>
        </oob>
    </template>
</category>

